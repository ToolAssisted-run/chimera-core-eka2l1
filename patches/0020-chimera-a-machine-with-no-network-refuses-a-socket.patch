--- a/src/emu/config/include/config/config.h
+++ b/src/emu/config/include/config/config.h
@@ -128,6 +128,20 @@ namespace eka2l1::config {
         bool nearest_neighbor_filtering{ true };
         bool integer_scaling{ true };
         bool cpu_load_save{ true };
+
+        // Application registries are scanned on a pool as wide as the host has
+        // cores, and the order they land in the list is the order the workers
+        // finish. Two machines, or two runs, can end up with the same apps in a
+        // different order. An emulator that has to answer the same way every
+        // time scans on the calling thread instead.
+        bool single_thread_app_scan{ false };
+
+        // Whether this machine has a network at all. The internet stack starts
+        // a libuv loop - an epoll descriptor and a thread of its own - the
+        // moment an application opens a socket. A machine that has no network
+        // to reach refuses the socket instead, which is an answer every
+        // application already handles.
+        bool enable_networking{ true };
         bool mime_detection{ true };
 
         std::atomic<bool> stepping{ false };

diff --git a/src/emu/system/include/system/epoc.h b/src/emu/system/include/system/epoc.h
index f45a7016a..427c7f1c7 100644
--- a/src/emu/system/include/system/epoc.h
+++ b/src/emu/system/include/system/epoc.h
@@ -91,6 +91,17 @@ namespace eka2l1 {
     using hal_instance = std::unique_ptr<epoc::hal>;
     using system_reset_callback_type = std::function<void(system *)>;
 
+    /**
+     * @brief Told how many instructions the last loop() gave the machine.
+     *
+     * The emulator has no cycle model: loop() runs the current thread for its
+     * remaining quantum and moves on. An owner that pays for those instructions
+     * in time of its own - a core whose clock is virtual - needs to know how
+     * many there were, and this is where it is told. Called once per loop() in
+     * which a thread actually ran, never with zero.
+     */
+    using cpu_ticks_callback_type = std::function<void(const std::uint32_t instructions)>;
+
     enum zip_mount_error {
         zip_mount_error_none,
         zip_mount_error_not_zip,
@@ -146,6 +157,8 @@ namespace eka2l1 {
 
         void prepare_reschedule();
 
+        void set_cpu_ticks_callback(cpu_ticks_callback_type callback);
+
         void startup();
         bool load(const std::u16string &path, const std::u16string &cmd_arg);
 

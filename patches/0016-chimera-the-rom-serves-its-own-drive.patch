+    /* A directory read out of the ROM's own tree.
+     *
+     * The tree is what the ROM says its filesystem is, and it is complete: a
+     * device whose ROM is present needs nothing else on the host to enumerate
+     * drive Z. Entries come back in the order the ROM holds them, which is the
+     * order it was built in and is the same on every machine.
+     */
+    class rom_directory : public directory {
+        abstract_file_system *inst;
+        std::string vir_path;
+        std::string filter;
+        epoc::uid_type utype;
+
+        std::vector<std::string> names;
+        std::size_t at;
+
+        bool peeking;
+        std::optional<entry_info> peek_info;
+
+    public:
+        rom_directory(abstract_file_system *inst, loader::rom_dir *dir, const std::string &vir_path,
+            const std::string &filter, epoc::uid_type type, const std::uint32_t attrib)
+            : directory(attrib)
+            , inst(inst)
+            , vir_path(vir_path)
+            , filter(filter)
+            , utype(type)
+            , at(0)
+            , peeking(false) {
+            this->type = io_component_type::dir;
+
+            for (const auto &entry : dir->entries) {
+                names.push_back(common::ucs2_to_utf8(entry.name));
+            }
+        }
+
+        std::optional<entry_info> get_next_entry() override {
+            if (peeking) {
+                peeking = false;
+                return peek_info;
+            }
+
+            while (at < names.size()) {
+                const std::string name = names[at++];
+
+                if ((name == ".") || (name == "..")) {
+                    continue;
+                }
+
+                if (!common::full_wildcard_match<char>(common::lowercase_string(name),
+                        common::lowercase_string(filter), false)) {
+                    continue;
+                }
+
+                const std::string full = eka2l1::add_path(vir_path, name);
+                std::optional<entry_info> info = inst->get_entry_info(common::utf8_to_ucs2(full));
+
+                if (!info.has_value()) {
+                    continue;
+                }
+
+                if (attribute != io_attrib_none) {
+                    if (!(attribute & io_attrib_include_dir) && (info->type == io_component_type::dir)) {
+                        continue;
+                    }
+
+                    if (!(attribute & io_attrib_include_file) && (info->type == io_component_type::file)) {
+                        continue;
+                    }
+                }
+
+                if ((attribute & io_attrib_include_file) && (attribute & io_attrib_allow_uid)
+                    && (info->type == io_component_type::file)) {
+                    epoc::uid_type found;
+                    std::unique_ptr<file> handle = inst->open_file(common::utf8_to_ucs2(full), READ_MODE | BIN_MODE);
+
+                    if (!handle || (handle->read_file(&found, sizeof(found), 1) != sizeof(found))) {
+                        continue;
+                    }
+
+                    if (((utype.uid1 != 0) && (utype.uid1 != found.uid1))
+                        || ((utype.uid2 != 0) && (utype.uid2 != found.uid2))
+                        || ((utype.uid3 != 0) && (utype.uid3 != found.uid3))) {
+                        continue;
+                    }
+                }
+
+                return info;
+            }
+
+            return std::nullopt;
+        }
+
+        std::optional<entry_info> peek_next_entry() override {
+            if (!peeking) {
+                peek_info = get_next_entry();
+                peeking = true;
+            }
+
+            return peek_info;
+        }
+    };

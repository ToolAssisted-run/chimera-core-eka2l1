+        // The ROM carries its own filesystem, and it is complete. Asking the
+        // host first - which is what this used to do everywhere, "don't bother
+        // if it's not even available on host" - meant a device could only be
+        // used with a copy of its ROM's files unpacked beside it, and the copy
+        // answered where the ROM should have. The ROM is asked first now, and
+        // the host is what answers for the files the ROM does not have.
+        bool exists(const std::u16string &path) override {
+            std::string rom_path = common::ucs2_to_utf8(rom_path_of(path));

diff --git a/src/external/uvlooper/include/uvlooper/uvlooper.h b/src/external/uvlooper/include/uvlooper/uvlooper.h
index 1efbe4d85..7614fbcd4 100644
--- a/src/external/uvlooper/include/uvlooper/uvlooper.h
+++ b/src/external/uvlooper/include/uvlooper/uvlooper.h
@@ -134,5 +134,53 @@ namespace libuv {
         return std::nullopt;
     }
 
-    extern std::shared_ptr<looper> default_looper;
+    // The default loop, built the first time something asks for it.
+    //
+    // It used to be a namespace-scope shared_ptr, which meant every process
+    // linking this opened an epoll descriptor before main - a test, a tool, a
+    // build with no networking at all - and a host whose sandbox has no epoll
+    // could not start the program even to say so. This proxy is stateless and
+    // holds the loop in a function-local static, so every call site reads the
+    // same loop and none of them changes.
+    struct default_looper_proxy {
+        // The loop, built on the first call. Nothing here is thread safe
+        // beyond what a function-local static already gives, which is what
+        // the namespace-scope object it replaced offered too.
+        static std::shared_ptr<looper> &instance() {
+            static std::shared_ptr<looper> inst = std::make_shared<looper>(uv_default_loop());
+            built() = true;
+            return inst;
+        }
+
+        static bool &built() {
+            static bool has_been = false;
+            return has_been;
+        }
+
+        // Whether the loop is running. Asking is NOT using: a loop nobody
+        // built has not started, and answering that must not build one -
+        // teardown paths ask this, and building a loop while tearing down
+        // opens a descriptor and a thread that nothing will ever close.
+        bool started() const {
+            return built() && instance()->started();
+        }
+
+        looper *operator->() const {
+            return instance().get();
+        }
+
+        looper &operator*() const {
+            return *instance();
+        }
+
+        operator std::shared_ptr<looper>() const {
+            return instance();
+        }
+
+        explicit operator bool() const {
+            return static_cast<bool>(instance());
+        }
+    };
+
+    extern default_looper_proxy default_looper;
 }

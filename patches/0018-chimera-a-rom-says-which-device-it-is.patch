+    // The bytes of one file in the ROM, read straight out of the image.
+    static bool read_rom_file(loader::rom &romf, common::ro_stream *stream, const std::string &path,
+        std::string &out) {
+        std::optional<loader::rom_entry> entry = romf.burn_tree_find_entry(path);
+
+        if (!entry || entry->dir) {
+            return false;
+        }
+
+        out.resize(entry->size);
+
+        if (out.empty()) {
+            return true;
+        }
+
+        // Where the entry lives in the image: the ROM is mapped at a base
+        // address, and an entry names where it would be once mapped.
+        stream->seek(entry->address_lin - romf.header.rom_base, common::seek_where::beg);
+
+        return stream->read(out.data(), out.size()) == out.size();
+    }
+
+    static bool determine_symbian_version_from_rom(loader::rom &romf, common::ro_stream *stream, epocver &ver) {
+        std::string platform_txt;
+
+        if (read_rom_file(romf, stream, "Z:\\resource\\versions\\platform.txt", platform_txt)) {
+            common::ini_file platform_ini;
+
+            if (platform_ini.load_from_memory(platform_txt) == 0) {
+                auto major_node = platform_ini.find("SymbianOSMajorVersion");
+                auto minor_node = platform_ini.find("SymbianOSMinorVersion");
+
+                if (major_node && minor_node) {
+                    const int major = major_node->get_as<common::ini_pair>()->get<common::ini_value>(0)->get_as_native<std::uint8_t>();
+                    const int minor = minor_node->get_as<common::ini_pair>()->get<common::ini_value>(0)->get_as_native<std::uint8_t>();
+
+                    const std::optional<epocver> discovered = get_epocver_through_platform_version(major, minor);
+
+                    if (discovered) {
+                        ver = discovered.value();
+                        return true;
+                    }
+                }
+            }
+        }
+
+        // The installed Series 60 package names the version the device is, and
+        // an EKA1 ROM has nothing else that does.
+        loader::rom_dir *install_dir = romf.burn_tree_find_dir("Z:\\system\\install");
+
+        if (!install_dir) {
+            return false;
+        }
+
+        bool found = false;
+
+        for (const loader::rom_entry &entry : install_dir->entries) {
+            const std::string name_utf8 = common::lowercase_string(common::ucs2_to_utf8(entry.name));
+
+            if (name_utf8.compare(0, 9, "series60v") != 0) {
+                continue;
+            }
+
+            const common::pystr name(name_utf8);
+
+            auto version_strings = name.split('.');
+
+            if (version_strings.size() < 2) {
+                continue;
+            }
+
+            const int major = version_strings[0].substr(9, std::string::npos).as_int<int>();
+            const int minor = version_strings[1].as_int<int>();
+
+            const std::optional<epocver> discovered = get_epocver_through_sis_name_version(major, minor);
+
+            if (discovered && (!found || (discovered.value() > ver))) {
+                ver = discovered.value();
+                found = true;
+            }
+        }
+
+        if (!found) {
+            for (const loader::rom_entry &entry : install_dir->entries) {
+                const std::string name = common::lowercase_string(common::ucs2_to_utf8(entry.name));
+
+                if (name == "series80v20.sis") {
+                    ver = epocver::epoc7;
+                    return true;
+                }
+
+                if (name == "series80v10.sis") {
+                    ver = epocver::epoc6;
+                    return true;
+                }
+            }
+        }
+
+        return found;
+    }
+
+    bool determine_device_from_rom(loader::rom &romf, common::ro_stream *stream, std::string &manufacturer,
+        std::string &firmcode, std::string &model, epocver &ver) {
+        if (!determine_symbian_version_from_rom(romf, stream, ver)) {
+            LOG_WARN(SYSTEM, "The ROM does not say which Symbian it is; assuming the default");
+        }
+
+        std::string product_txt;
+
+        if (read_rom_file(romf, stream, "Z:\\resource\\versions\\product.txt", product_txt)) {
+            common::ini_file product_ini;
+
+            if (product_ini.load_from_memory(product_txt, false) == 0) {
+                auto manufacturer_node = product_ini.find("Manufacturer");
+                auto product_node = product_ini.find("Product");
+                auto model_node = product_ini.find("Model");
+
+                if (manufacturer_node && product_node && model_node) {
+                    manufacturer = manufacturer_node->get_as<common::ini_pair>()->get<common::ini_value>(0)->get_value();
+                    firmcode = product_node->get_as<common::ini_pair>()->get<common::ini_value>(0)->get_value();
+                    model = model_node->get_as<common::ini_pair>()->get<common::ini_value>(0)->get_value();
+
+                    return true;
+                }
+            }
+        }
+
+        // The older layout: one file of newline separated fields, in UCS-2.
+        std::string sw_txt;
+
+        if (!read_rom_file(romf, stream, "Z:\\system\\versions\\sw.txt", sw_txt)
+            && !read_rom_file(romf, stream, "Z:\\system\\versions\\langsw.txt", sw_txt)) {
+            return false;
+        }
+
+        common::dynamic_ifile sw_file(sw_txt, true);
+        std::string line_buffer;
+
+        sw_file.getline(line_buffer);
+
+        common::pystr sw_line_py(line_buffer);
+        auto sw_infos = sw_line_py.split("\\n");
+
+        if (sw_infos.size() < 3) {
+            return false;
+        }
+
+        firmcode = sw_infos[2].strip_reserverd().std_str();
+        manufacturer = (sw_infos.size() >= 4) ? sw_infos[3].strip_reserverd().std_str() : "Unknown";
+
+        std::string model_txt;
+
+        if (read_rom_file(romf, stream, "Z:\\system\\versions\\model.txt", model_txt)) {
+            common::dynamic_ifile model_file(model_txt, true);
+            model_file.getline(model);
+        } else {
+            model = sw_infos[0].strip_reserverd().std_str();
+        }
+
+        return true;
+    }
 }

+    /**
+     * @brief The source of "now", in microseconds since 1/1/1970.
+     *
+     * Everything time-like in the emulator arrives here in the end: the calendar
+     * reads below, and through them basic_teletimer_micro, which is what the
+     * nanokernel timer measures the machine with. An embedder whose machine must
+     * not depend on the host clock - a deterministic core, a replay, a test -
+     * installs its own source and the wall is never read again.
+     *
+     * Install before the machine starts. An empty source restores the wall.
+     */
+    using utc_time_source = std::function<std::uint64_t()>;
+
+    void set_utc_time_source(utc_time_source source);
+

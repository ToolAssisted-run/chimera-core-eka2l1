+    // Reads a file whole into memory somebody else owns. The fallback for a
+    // host that cannot map files.
+    static bool read_whole_file(const std::string &path, void *into, const std::size_t size) {
+        FILE *f = common::open_c_file(path, "rb");
+
+        if (!f) {
+            return false;
+        }
+
+        const std::size_t read = fread(into, 1, size, f);
+        fclose(f);
+
+        return read == size;
+    }

+        package::installation_result packages::install_stub_from_memory(std::vector<std::uint8_t> &bytes, const drive_number drive) {
+            if (bytes.size() < 4) {
+                return package::installation_result_invalid;
+            }
+
+            std::uint32_t uid1 = 0;
+            std::memcpy(&uid1, bytes.data(), 4);
+
+            // Only the new format's stub - a bare controller - is read this way; an
+            // old-format package goes through a path-only installer.
+            if (uid1 != static_cast<std::uint32_t>(loader::sis_field_type::SISController)) {
+                return package::installation_result_invalid;
+            }
+
+            auto parse_stream = std::make_shared<common::ro_buf_stream>(bytes.data(), bytes.size());
+            loader::sis_parser parser(parse_stream);
+
+            loader::sis_contents res;
+            res.controller = parser.parse_controller();
+
+            common::ro_buf_stream stream(bytes.data(), bytes.size());
+            loader::ss_interpreter interpreter(reinterpret_cast<common::ro_stream *>(&stream), sys, this, &res.controller, &res.data, drive);
+
+            if (var_resolver) {
+                interpreter.var_resolver = var_resolver;
+            }
+
+            std::unique_ptr<loader::sis_registry_tree> new_infos = interpreter.interpret(nullptr, nullptr);
+
+            if (!new_infos) {
+                return package::installation_result_aborted;
+            }
+
+            traverse_tree_and_add_packages(*new_infos);
+
+            LOG_TRACE(PACKAGE, "Installation done!");
+            return package::installation_result_success;
         }
 
